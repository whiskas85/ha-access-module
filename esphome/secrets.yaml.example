# ═══════════════════════════════════════════════════════════════════════════
#  TEMPLATE — copiare in secrets.yaml e valorizzare.
#
#  secrets.yaml è escluso dal versionamento (.gitignore). Questo file .example
#  documenta SOLO i nomi delle chiavi, mai i valori.
#
#  Se un valore reale finisce qui e viene committato, non basta rimuoverlo con
#  un commit successivo: resta nella storia del repo, che è pubblico, e va
#  riscritta con git filter-repo. Verificare prima di ogni commit.
# ═══════════════════════════════════════════════════════════════════════════

# ── API ESPHome: cifratura Noise ───────────────────────────────────────────
# Generare con:  openssl rand -base64 32
api_key: "GENERARE-32-BYTE-BASE64"

# ── OTA ────────────────────────────────────────────────────────────────────
ota_password: "GENERARE-PASSWORD-LUNGA"

# ── Access point di fallback del nodo ──────────────────────────────────────
ap_password: "GENERARE-PASSWORD-LUNGA"

# ── WiFi ───────────────────────────────────────────────────────────────────
# Da mettere su VLAN/SSID IoT isolata: il nodo esterno è il dispositivo più
# esposto dell'impianto e non deve poter raggiungere il resto della rete.
wifi_ssid: "SSID-RETE-IOT"
wifi_password: "PASSWORD-RETE-IOT"


# ═══════════════════════════════════════════════════════════════════════════
#  NOTA — gli UID delle tessere NON stanno qui, e non stanno da nessuna parte
#  in questo repository.
#
#  Vivono nel registro dell'integration, che è dati di Home Assistant e non
#  file versionati. Si censiscono passando la tessera al lettore dopo aver
#  premuto "Abilita lettura tessera" nel pannello: non c'è nessun UID da
#  trascrivere, quindi non c'è nessun UID che possa finire in un commit.
# ═══════════════════════════════════════════════════════════════════════════
