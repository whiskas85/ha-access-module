# ═══════════════════════════════════════════════════════════════════════════
#  TEMPLATE — copiare in secrets.yaml e valorizzare.
#
#  secrets.yaml e' escluso dal versionamento (.gitignore). Questo file .example
#  documenta SOLO i nomi delle chiavi, mai i valori.
#
#  Se un valore reale finisce qui e viene committato, non basta rimuoverlo con
#  un commit successivo: resta nella storia del repo, che e' pubblico, e va
#  riscritta con git filter-repo. Verificare prima di ogni commit.
# ═══════════════════════════════════════════════════════════════════════════

# ── API ESPHome: cifratura Noise ───────────────────────────────────────────
# Generare con:  openssl rand -base64 32
rfid_ingresso_api_key: "GENERARE-32-BYTE-BASE64"

# ── OTA ────────────────────────────────────────────────────────────────────
rfid_ingresso_ota_password: "GENERARE-PASSWORD-LUNGA"

# ── Access point di fallback del nodo ──────────────────────────────────────
rfid_ingresso_ap_password: "GENERARE-PASSWORD-LUNGA"

# ── WiFi della VLAN/SSID IoT isolata ───────────────────────────────────────
# NON la rete di casa: il nodo esterno e' il dispositivo piu' esposto
# dell'impianto e non deve poter raggiungere il resto della rete.
iot_wifi_ssid: "SSID-RETE-IOT"
iot_wifi_password: "PASSWORD-RETE-IOT"


# ═══════════════════════════════════════════════════════════════════════════
#  NOTA — gli UID dei tag NON stanno qui.
#
#  Vivono negli helper di Home Assistant:
#      input_text.access_cred_bambino
#      input_text.access_cred_adulto_1
#      input_text.access_cred_adulto_2
#
#  Motivo: il package deve caricare anche su un'installazione pulita, senza
#  dipendere da chiavi di secrets che potrebbero non esistere; e il confronto
#  fra UID letto e UID censito avviene in un template, che non puo' leggere
#  secrets.yaml. Gli helper non sono versionati, quindi la garanzia e' la
#  stessa.
# ═══════════════════════════════════════════════════════════════════════════
